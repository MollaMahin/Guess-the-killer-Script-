local RevealsSection = MainTab:CreateSection("Reveals")

local RevealKillerToggle = MainTab:CreateToggle({
   Name = "Reveal the Killer",
   CurrentValue = false,
   Flag = "RevealKiller_Toggle_Flag",
   Callback = function(Value)
      RevealKillerEnabled = Value
      
      if RevealKillerEnabled then
         task.spawn(function()
            while RevealKillerEnabled do
               for _, player in ipairs(game.Players:GetPlayers()) do
                  if player ~= game.Players.LocalPlayer then
                     if isPlayerKiller(player) then
                        applyKillerTag(player)
                     else
                        removeKillerTag(player)
                     end
                  end
               end
               task.wait(0.2)
            end
         end)
      else
         IdentifiedKillers = {}
         for player, _ in pairs(KillerTags) do
            removeKillerTag(player)
         end
      end
   end,
})

